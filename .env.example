# Razorpay test mode. Get these from the Razorpay dashboard in Test Mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Google Gemini API key. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Authorize-step mode: sim | live
#   This toggle swaps ONLY the authorize step — the moment a human taps a card.
#   Orders, Offers, Payment Links, captures, refunds and subscriptions hit the
#   real Razorpay API in BOTH modes. The simulator never fakes Razorpay itself.
AUTHORIZE_MODE=sim

# LLM mode: live | cassette
#   cassette replays recorded model responses so demos and tests are deterministic.
LLM_MODE=cassette

# Optional: public base URL for Razorpay webhooks (ngrok etc).
# Leave blank to use polling instead.
PUBLIC_BASE_URL=
RAZORPAY_WEBHOOK_SECRET=
