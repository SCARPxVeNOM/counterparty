{
  "name": "counterparty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The merchant's selling agent, with a signed selling mandate.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "pnpm --filter @counterparty/web dev",
    "cli": "tsx apps/cli/src/index.ts",
    "demo": "tsx scenarios/run-all.ts",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "record:cassettes": "tsx scripts/record-cassettes.ts",
    "tamper:check": "tsx scripts/tamper-ledger.ts"
  },
  "devDependencies": {
    "@counterparty/agents": "workspace:*",
    "@counterparty/config": "workspace:*",
    "@counterparty/core": "workspace:*",
    "@counterparty/demo": "workspace:*",
    "@counterparty/llm": "workspace:*",
    "@counterparty/rails": "workspace:*",
    "@counterparty/store": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.3.0",
    "better-sqlite3": "^13.0.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  }
}
